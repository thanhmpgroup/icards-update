# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đưa file .env lên Git.

# --- Máy chủ ---
NODE_ENV=production
PORT=5000
# Thư mục build React của web công khai (mặc định /home/icards/icards/build)
FRONTEND_BUILD_DIR=/home/icards/icards/build
SITE_URL=https://icards.com.vn
FRONTEND_URL=https://icards.com.vn

# --- Cơ sở dữ liệu & đăng nhập ---
MONGO_URI=mongodb://localhost:27017/icards
JWT_SECRET=
SESSION_SECRET=

# --- Đăng nhập Google / Facebook ---
CALLBACK_URL=https://api.icards.com.vn/api/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Email (Gmail, dùng App Password) ---
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="iCards" <no-reply@icards.com.vn>

# --- Cloudflare R2 (lưu ảnh người dùng) ---
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_NAME=

# --- Cloudflare Images (ảnh mẫu thiệp) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_HASH=mYCNH6-2h27PJijuhYd-fw

# --- Dịch vụ khác ---
FAL_KEY=
REACT_APP_Maps_API_KEY=
